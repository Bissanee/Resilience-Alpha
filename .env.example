# Copier ce fichier vers .env avant le premier demarrage.
# Ces valeurs sont uniquement des exemples pour le laboratoire local.
COMPOSE_PROJECT_NAME=resilience-alpha

POSTGRES_DB=resilience
POSTGRES_USER=resilience
POSTGRES_PASSWORD=change-me-local-postgres

JWT_SECRET=change-me-local-jwt-at-least-32-characters

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-grafana

OLLAMA_MODEL=llama3.2:3b
RAG_TOP_K=4
DETECTOR_INTERVAL_SECONDS=10
MIN_TRAINING_SAMPLES=30
DETECTOR_ALERT_THRESHOLD=0.78
DETECTOR_ALERT_COOLDOWN_SECONDS=120
# Optionnel : même valeur pour detector et remediation ; laisser vide pour désactiver le contrôle Bearer
REMEDIATION_TOKEN=
USER_PASSWORD=CHANGE_ME
MONITOR_PASSWORD=CHANGE_ME
