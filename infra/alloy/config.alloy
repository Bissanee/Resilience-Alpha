logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "resilience" {
  host             = "tcp://docker-proxy-ro:2375"
  refresh_interval = "5s"
}

discovery.relabel "resilience_logs" {
  targets = discovery.docker.resilience.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "resilience-alpha"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "resilience" {
  host             = "tcp://docker-proxy-ro:2375"
  targets          = discovery.relabel.resilience_logs.output
  labels           = { platform = "docker", project = "resilience-alpha" }
  forward_to       = [loki.process.resilience.receiver]
  refresh_interval = "5s"
}

loki.process "resilience" {
  stage.docker {}

  stage.json {
    expressions = {
      level      = "level",
      log_service = "service",
      event      = "event",
      request_id = "request_id",
      status     = "status",
    }
  }

  stage.labels {
    values = {
      level = "",
      event = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
