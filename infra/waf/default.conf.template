server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${PORT} default_server;
    server_name _;

    # Liste dynamique ecrite par remediation et montee en lecture seule ici.
    include /etc/waf-deny/blocked-ips.conf;

    # Endpoint de sante traverse le WAF et prouve que le front repond.
    location = /health {
        proxy_pass http://front:3000/health;
        include includes/proxy-common.conf;
    }

    # /auth/login devient /login pour le stub actuel. Le service definitif pourra
    # conserver ce routage ou adapter son prefixe selon le contrat commun.
    location /auth/ {
        limit_req zone=auth_rate burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://auth:4001/;
        include includes/proxy-common.conf;
    }

    # /api/transactions devient /transactions dans api-paiement.
    location /api/ {
        limit_req zone=api_rate burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://api-paiement:4000/;
        include includes/proxy-common.conf;
    }

    location / {
        proxy_pass http://front:3000;
        include includes/proxy-common.conf;
    }

    include includes/location_common.conf;
}
